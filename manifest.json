{
  "manifest_version": 3,
  "name": "Disney Photo Pass Downloader",
  "version": "1.0",
  "description": "Automatically download files from disneyphotopass.eu if the URL contains the obqs1 parameter.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "webRequest",
    "scripting",
    "downloads"
  ],
"background": {
    "service_worker": "background.js"
  },
	"web_accessible_resources": [
		{
		  "resources": ["pageScript.js"],
		  "matches": ["https://www.disneyphotopass.eu/*", "https://disneyphotopass.eu/*"]
		}
	],

  "content_scripts": [
    {
	"matches": [
    "https://disneyphotopass.eu/*",
    "https://www.disneyphotopass.eu/*"
	],
    "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
