{
  "manifest_version": 3,
  "name": "Disney Photo Pass Downloader",
  "version": "1.1.0",
  "description": "Download full-resolution Disney PhotoPass images (obqs1) from disneyphotopass.eu.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageScript.js"],
      "matches": [
        "https://www.disneyphotopass.eu/*",
        "https://disneyphotopass.eu/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://disneyphotopass.eu/*",
        "https://www.disneyphotopass.eu/*"
      ],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://www.disneyphotopass.eu/*",
    "https://disneyphotopass.eu/*"
  ]
}
